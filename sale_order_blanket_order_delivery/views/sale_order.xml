<odoo>

    <record model="ir.ui.view" id="sale_order_form_view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_order_blanket_order.sale_order_form_view" />
        <field name="arch" type="xml">
            <field name="blanket_strict_packaging" position="after">
                <field
                    name="blanket_strict_delivery_method"
                    attrs="{'invisible': [('order_type', '!=', 'blanket')]}"
                />
            </field>
        </field>
    </record>

</odoo>

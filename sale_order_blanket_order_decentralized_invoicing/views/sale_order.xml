<odoo>
    <record model="ir.ui.view" id="sale_order_form_view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_order_blanket_order.sale_order_form_view" />
        <field name="arch" type="xml">
            <field name="blanket_strict_packaging" position="after">
                <!-- Switching the option once invoiced would invoice some
                     quantities twice, or not at all -->
                <field
                    name="invoice_call_off_at_own_address"
                    invisible="order_type != 'blanket'"
                    readonly="invoice_count"
                />
            </field>
        </field>
    </record>
</odoo>

<odoo>
    <record model="ir.ui.view" id="res_config_settings_form_view">
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="sale_order_blanket_order.res_config_settings_form_view"
        />
        <field name="arch" type="xml">
            <div id="sale_config_online_confirmation_pay" position="after">
                <setting
                    id="blanket_invoice_call_off_at_own_address"
                    company_dependent="1"
                    help="Default for new blanket orders: invoice the deliveries of a call-off order at its own invoice and shipping addresses, when they differ from the blanket order's ones."
                >
                    <field name="blanket_invoice_call_off_at_own_address" />
                </setting>
            </div>
        </field>
    </record>
</odoo>
